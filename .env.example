FEISHU_MODE=local
HOST=127.0.0.1
PORT=5300
PUBLIC_BASE_URL=http://127.0.0.1:5300
DATABASE_PATH=./data/local.sqlite
PILOT_PRIMARY_UI=page
# Temporary private hotspot test only. Prefer start-phone.ps1; never use 0.0.0.0.
PILOT_LAN_PREVIEW=0
PILOT_LAN_CLIENTS=
PILOT_PRIMARY_UI=page
# Optional rollback: PILOT_PRIMARY_UI=cards restores the earlier private query cards.
# Private HTTP test preview is OFF by default. Prefer start-phone.ps1 for a
# temporary process-only override with a separate phone-preview.sqlite database.
PILOT_LAN_PREVIEW=0
PILOT_LAN_CLIENTS=

# Switch to feishu only after your team's app is configured.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TENANT_KEY=
# Exact allowlisted group IDs, separated by commas. No wildcard is supported.
FEISHU_ALLOWED_CHAT_IDS=
# Optional names in the same order; otherwise the interface displays the group ID.
FEISHU_CHAT_NAMES=

